# Copy this file to .env and fill in your API keys
OPENAI_API_KEY=sk-your-key-here

# Milvus for entity extraction tests (required for test_entity_extraction.py)
# Start Milvus: docker run -d --name milvus -p 19530:19530 milvusdb/milvus:latest standalone
MILVUS_URL=http://localhost:19530

